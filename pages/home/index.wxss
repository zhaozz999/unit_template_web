.home-page {
  background: #f5f5f7;
  color: #1d1d1f;
}

.home-container {
  padding-left: 26rpx;
  padding-right: 26rpx;
  box-sizing: border-box;
}

.top-meta {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a8a90;
}

.main-title {
  margin-top: 8rpx;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: #1d1d1f;
}

.subtitle-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #667085;
}

.hero-card {
  margin-top: 22rpx;
  border-radius: 40rpx;
  padding: 30rpx;
  background: #ffffff;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.03);
}

.hero-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #c3662d;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 700;
  color: #1d1d1f;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.52;
  color: #8c8c92;
}

.hero-meta {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-pill {
  max-width: 100%;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  font-size: 22rpx;
  color: #475467;
  word-break: break-all;
}

.meta-pill-wide {
  border-radius: 24rpx;
}

.feature-row + .feature-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f6;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.feature-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}
