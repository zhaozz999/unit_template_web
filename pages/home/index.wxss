.home-page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #1d1d1f;
}

.home-container {
  padding-left: 26rpx;
  padding-right: 26rpx;
  box-sizing: border-box;
}

.top-meta {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a8a90;
}

.main-title {
  margin-top: 8rpx;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: #1d1d1f;
}

.hero-card {
  margin-top: 22rpx;
  min-height: 420rpx;
  border-radius: 40rpx;
  padding: 30rpx;
  background: #ffffff;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.03);
}

.hero-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #c3662d;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 700;
  color: #1d1d1f;
}

.hero-subtitle {
  margin-top: 16rpx;
  width: 84%;
  font-size: 29rpx;
  line-height: 1.52;
  color: #8c8c92;
}

.feature-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.feature-item {
  min-height: 164rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 2px 14px rgba(0, 0, 0, 0.03);
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feature-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
}

.feature-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.bottom-tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 8rpx;
  background: rgba(245, 245, 247, 0.98);
  border-top: 1rpx solid #e6e6eb;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a90;
}

.active-text {
  color: #0071e3;
}