<view class="home-page">
  <view class="home-container" style="padding-top: {{navHeight + 8}}px; padding-bottom: {{120 + safeBottom}}px;">
    <view class="top-meta">{{dateLabel}}</view>
    <view class="main-title">探索</view>

    <view class="hero-card" bindtap="onHeroTap">
      <view class="hero-tag">{{hero.tag}}</view>
      <view class="hero-title">
        <view>{{hero.titleLine1}}</view>
        <view>{{hero.titleLine2}}</view>
      </view>
      <view class="hero-subtitle">{{hero.subtitle}}</view>
    </view>

    <view class="feature-grid">
      <view
        wx:for="{{featureList}}"
        wx:key="key"
        class="feature-item"
        data-item="{{item}}"
        bindtap="onFeatureTap"
      >
        <view class="feature-icon" style="background: {{item.iconColor}};"></view>
        <view class="feature-title">{{item.title}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-tab" style="height: {{100 + safeBottom}}px; padding-bottom: {{safeBottom}}px;">
    <view class="tab-item active" data-key="home" bindtap="onTabTap">
      <image class="tab-icon-img" src="/assets/tab/home-active.svg" mode="aspectFit" />
      <view class="tab-text active-text">首页</view>
    </view>
    <view class="tab-item" data-key="profile" bindtap="onTabTap">
      <image class="tab-icon-img" src="/assets/tab/profile.svg" mode="aspectFit" />
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>