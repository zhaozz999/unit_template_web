<view class="page-shell home-page">
  <view class="home-container" style="padding-top: {{navHeight + 12}}px; padding-bottom: {{120 + safeBottom}}px;">
    <view class="top-meta">{{dateLabel}}</view>
    <view class="main-title">{{appName}}</view>
    <view class="subtitle-text">Lightweight starter for reusable WeChat mini program delivery.</view>

    <view class="hero-card">
      <view class="hero-tag">Template overview</view>
      <view class="hero-title">Build once, reuse often.</view>
      <view class="hero-subtitle">
        This starter already wires login, request handling, local API override, layout helpers, and a business demo loop.
      </view>
      <view class="hero-meta">
        <view class="meta-pill">Env: {{runtimeEnv}}</view>
        <view class="meta-pill meta-pill-wide">API: {{apiBaseUrl}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">What is ready</view>
      <view wx:for="{{featureList}}" wx:key="key" class="feature-row">
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">Quick actions</view>
      <view class="status-line">Login status: {{isLoggedIn ? 'Connected' : 'Not logged in'}}</view>
      <view class="status-line" wx:if="{{currentUserName}}">Current user: {{currentUserName}}</view>

      <view class="button-group">
        <button class="btn-primary" bindtap="goUserDemo">Open user demo</button>
        <button class="btn-secondary" bindtap="goLogin">{{isLoggedIn ? 'Open profile' : 'Go to login'}}</button>
        <button class="btn-ghost" wx:if="{{runtimeEnv !== 'release'}}" bindtap="resetApiBaseUrl">Reset local API endpoint</button>
      </view>
    </view>
  </view>

  <bottom-tab active="home" safe-bottom="{{safeBottom}}" />
</view>
