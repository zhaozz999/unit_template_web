.login-card {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  font-size: 24rpx;
  color: #344054;
}

.value {
  font-size: 28rpx;
  color: #0b1220;
  font-weight: 600;
}

.value-break {
  word-break: break-all;
}

.input {
  height: 76rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  background: #f8fafc;
}

.auto-tip {
  font-size: 24rpx;
  color: #475467;
}

.error-tip {
  font-size: 24rpx;
  color: #c12222;
  background: #fff1f1;
  border: 1rpx solid #ffc9c9;
  border-radius: 10rpx;
  padding: 16rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
