<view class="container">
  <view class="card login-card">
    <view class="title">{{appName}}</view>
    <view class="subtitle">Reusable WeChat login page with local API override and development mock support.</view>

    <view class="field">
      <text class="label">Current environment</text>
      <text class="value">{{runtimeEnv}}</text>
    </view>

    <view class="field">
      <text class="label">Current API endpoint</text>
      <text class="value value-break">{{apiBaseUrl}}</text>
    </view>

    <view class="field" wx:if="{{runtimeEnv !== 'release'}}">
      <text class="label">Local API endpoint override</text>
      <input
        class="input"
        placeholder="http://127.0.0.1:8086"
        value="{{apiBaseUrlInput}}"
        bindinput="onApiBaseUrlInput"
      />
      <view class="button-row">
        <button size="mini" bindtap="saveApiBaseUrl">Save endpoint</button>
        <button size="mini" bindtap="clearApiBaseUrl">Reset endpoint</button>
      </view>
    </view>

    <view class="field" wx:if="{{runtimeEnv !== 'release'}}">
      <text class="label">Development openId</text>
      <input
        class="input"
        placeholder="Used for local mock login"
        value="{{devOpenId}}"
        bindinput="onDevOpenIdInput"
      />
    </view>

    <view class="auto-tip" wx:if="{{loading}}">Logging in, please wait...</view>
    <view class="error-tip" wx:if="{{autoLoginFailed}}">Auto login failed: {{autoLoginMessage}}</view>

    <view class="btn-group">
      <button class="btn-primary" loading="{{loading}}" bindtap="handleLogin">Login with WeChat</button>
      <button class="btn-secondary" wx:if="{{runtimeEnv !== 'release'}}" bindtap="retryAutoLogin">Retry local auto login</button>
    </view>
  </view>
</view>
