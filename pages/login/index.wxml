<view class="container">
  <view class="card login-card">
    <view class="title">小程序模板登录</view>
    <view class="subtitle">默认会先静默自动登录，失败后再手动重试</view>

    <view class="field">
      <text class="label">当前环境</text>
      <text class="value">{{runtimeEnv}}</text>
    </view>

    <view class="field" wx:if="{{runtimeEnv !== 'prod'}}">
      <text class="label">开发 openId（仅开发环境）</text>
      <input
        class="input"
        placeholder="用于本地 mock 登录"
        value="{{devOpenId}}"
        bindinput="onDevOpenIdInput"
      />
    </view>

    <view class="auto-tip" wx:if="{{loading}}">正在自动登录，请稍候...</view>

    <view class="error-tip" wx:if="{{autoLoginFailed}}">自动登录失败：{{autoLoginMessage}}</view>

    <view class="btn-group" wx:if="{{autoLoginFailed}}">
      <button class="btn-primary" bindtap="retryAutoLogin">再次自动登录</button>
      <button class="btn-secondary" loading="{{loading}}" bindtap="handleLogin">手动登录（获取头像昵称）</button>
    </view>
  </view>
</view>
