<view class="container">
  <view class="card header-card">
    <view class="title header-title">{{modeLabel}}</view>
    <view class="subtitle">{{pageTitle}} sample form. Reuse this page structure for future create and edit flows.</view>
  </view>

  <view class="card form-card">
    <view class="field">
      <text class="label">Open ID</text>
      <input
        class="input"
        placeholder="Enter openId"
        value="{{form.openId}}"
        data-field="openId"
        bindinput="onInput"
        disabled="{{mode === 'edit'}}"
      />
    </view>

    <view class="field">
      <text class="label">Nickname</text>
      <input
        class="input"
        placeholder="Enter nickname"
        value="{{form.nickName}}"
        data-field="nickName"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">Avatar URL</text>
      <input
        class="input"
        placeholder="Enter avatar url"
        value="{{form.avatarUrl}}"
        data-field="avatarUrl"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">Status</text>
      <input
        class="input"
        placeholder="0 means active, 1 means disabled"
        value="{{form.status}}"
        data-field="status"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">Remark</text>
      <textarea
        class="textarea"
        placeholder="Enter remark"
        value="{{form.remark}}"
        data-field="remark"
        bindinput="onInput"
      />
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="onSubmit">Save</button>
  </view>
</view>
