<view class="container">
  <view class="card toolbar">
    <input
      class="search-input"
      placeholder="按昵称搜索"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="toolbar-btns">
      <button size="mini" bindtap="onSearch">查询</button>
      <button size="mini" type="primary" bindtap="goCreate">新增</button>
      <button size="mini" type="warn" bindtap="logout">退出</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:if="{{!loading && users.length === 0}}" class="empty">暂无用户数据</view>

  <view wx:for="{{users}}" wx:key="userId" class="card user-card">
    <view class="row">
      <text class="name">{{item.nickName}}</text>
      <text class="status">状态: {{item.status}}</text>
    </view>
    <view class="sub">用户ID: {{item.userId}}</view>
    <view class="sub">openId: {{item.openId}}</view>
    <view class="sub">最近登录: {{item.lastLoginTimeText || '-'}}</view>
    <view class="actions">
      <button size="mini" bindtap="goEdit" data-user-id="{{item.userId}}">编辑</button>
      <button size="mini" type="warn" bindtap="onDelete" data-user-id="{{item.userId}}">删除</button>
    </view>
  </view>
</view>
