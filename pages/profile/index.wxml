<view class="page-shell profile-page">
  <view class="profile-container" style="padding-top: {{navHeight + 12}}px; padding-bottom: {{120 + safeBottom}}px;">
    <view class="profile-header">
      <view class="avatar">{{avatarText}}</view>
      <view class="profile-meta">
        <view class="profile-name">{{user ? (user.nickName || user.openId) : appName}}</view>
        <view class="profile-id">{{user ? user.openId : 'No active session'}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">Runtime</view>
      <view class="status-line">Environment: {{runtimeEnv}}</view>
      <view class="status-line">API endpoint: {{apiBaseUrl}}</view>
      <view class="status-line" wx:if="{{usingCustomApi}}">Using a custom local API override.</view>
      <view class="status-line">Session: {{sessionLabel}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">Current user</view>
      <view class="status-line">Nickname: {{user ? user.nickName : '-'}}</view>
      <view class="status-line">User ID: {{user ? user.userId : '-'}}</view>
      <view class="status-line">Open ID: {{user ? user.openId : '-'}}</view>
      <view class="status-line">Status: {{user ? user.status : '-'}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">Actions</view>
      <view class="button-group">
        <button class="btn-primary" bindtap="goUserDemo">Open user demo</button>
        <button class="btn-secondary" bindtap="goLogin">Go to login</button>
        <button class="btn-danger" bindtap="onLogout">Logout</button>
      </view>
    </view>
  </view>

  <bottom-tab active="profile" safe-bottom="{{safeBottom}}" />
</view>
