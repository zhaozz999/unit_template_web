.profile-page {
  background: #f5f5f7;
  color: #1d1d1f;
}

.profile-container {
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.profile-header {
  padding: 16rpx 12rpx 12rpx;
  display: flex;
  align-items: center;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f3f5f8 100%);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #0071e3;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-meta {
  margin-left: 20rpx;
}

.profile-name {
  font-size: 46rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.12;
}

.profile-id {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a8a90;
  word-break: break-all;
}
