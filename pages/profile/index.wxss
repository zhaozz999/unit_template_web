.profile-page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #1d1d1f;
}

.profile-container {
  padding-left: 8rpx;
  padding-right: 8rpx;
  box-sizing: border-box;
}

.profile-header {
  padding: 16rpx 12rpx 12rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #d7d7db;
}

.profile-meta {
  margin-left: 20rpx;
}

.profile-name {
  font-size: 46rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.12;
}

.profile-id {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: #8a8a90;
}

.group-wrap {
  margin-top: 16rpx;
}

.group-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2px 14px rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.group-row {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.group-row + .group-row {
  border-top: 1rpx solid #efeff4;
}

.row-left {
  font-size: 34rpx;
  color: #1d1d1f;
}

.danger {
  color: #ff4a4a;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-value {
  font-size: 28rpx;
  color: #b8b8be;
}

.row-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #c6c6cc;
}

.bottom-tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 8rpx;
  background: rgba(245, 245, 247, 0.98);
  border-top: 1rpx solid #e6e6eb;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a90;
}

.active-text {
  color: #0071e3;
}