page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 40rpx 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  color: #1d1d1f;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6e6e73;
}

.btn-primary {
  width: 100%;
  border-radius: 24rpx;
  background: #0071e3;
  color: #ffffff;
}

.btn-danger {
  border-radius: 24rpx;
  background: #d84f4f;
  color: #ffffff;
}