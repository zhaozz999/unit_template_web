page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 40rpx 32rpx;
}

.page-shell {
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  color: #1d1d1f;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6e6e73;
}

button {
  border-radius: 24rpx;
}

button::after {
  border: none;
}

.btn-primary {
  width: 100%;
  border-radius: 24rpx;
  background: #0071e3;
  color: #ffffff;
}

.btn-secondary {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #111827;
  border: 1rpx solid #d0d5dd;
}

.btn-ghost {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  color: #344054;
}

.btn-danger {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #d84f4f;
  color: #ffffff;
}

.section-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}

.status-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #475467;
  word-break: break-all;
}

.button-group {
  margin-top: 20rpx;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.button-row button {
  flex: 1;
  min-width: 180rpx;
}
